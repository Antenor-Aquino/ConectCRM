{
  "manifest_version": 3,
  "name": "ConectCRM",
  "version": "0.1.0",
  "description": "CRM local com funis, Kanban, tarefas, contatos e organizações - dados no seu computador.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ConectCRM"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://extpipe.claudiacrm.com.br/*",
    "https://brasilapi.com.br/*",
    "https://minhareceita.org/*",
    "https://www.receitaws.com.br/*",
    "https://viacep.com.br/*"
  ]
}
